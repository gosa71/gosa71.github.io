{
  "type": "list",
  "headline": "Популярные фильмы",
  "extension": {
    "request": {
      "url": "https://api.themoviedb.org/3/movie/popular?api_key=65f645cfefa38f91de626946336499b0&language=ru",
      "ready": {
        "items": "@model.results"
      }
    }
  },
  "template": {
    "type": "default",
    "layout": "0,0,3,4",
    "id": "{id}",
    "label": "{title} ({release_date})",
    "image": "https://image.tmdb.org/t/p/w500{poster_path}",
    "action": "content:https://gosa71.github.io/index.html?tmdb_id={id}"
  }
}
