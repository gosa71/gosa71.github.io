{
  "type": "pages",
  "headline": "Фильмы Zona",
  "extension": {
    "request": {
      "url": "https://api.allorigins.win/raw?url=https%3A%2F%2Fapi.zonafilm.ru%2Fapi%2Fmovies%3Fpage%3D1",
      "ready": {
        "data": "@model.data"
      }
    }
  },
  "data": [
    {
      "type": "default",
      "id": "{slug}",
      "label": "{title} ({year})",
      "image": "{cover_url}",
      "action": "content:https://gosa71.github.io/index.html?kp_id={kp_id}"
    }
  ]
}
